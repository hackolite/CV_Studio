# CV Studio Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# The .env file is git-ignored for security

# AIS Stream WebSocket API Configuration
# Get your free API key at: https://aisstream.io/
AIS_STREAM_API_KEY=your_api_key_here

# Optional: Default WebSocket URL
# AIS_STREAM_URL=wss://stream.aisstream.io/v0/stream

# Optional: Default bounding box (JSON format)
# Example Mediterranean Sea: [[[-5, 36], [36, 36], [36, 46], [-5, 46], [-5, 36]]]
# AIS_STREAM_BOUNDING_BOX=[[[-5, 36], [36, 36], [36, 46], [-5, 46], [-5, 36]]]
